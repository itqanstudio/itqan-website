{
  "name": "itqan-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "verify:design": "node scripts/verify-apple-design.mjs",
    "brand:sync": "node scripts/sync-brand-assets.mjs",
    "brand:bundles": "node scripts/build-brand-bundles.mjs",
    "prebuild": "node scripts/build-brand-bundles.mjs",
    "test:routing": "node --no-warnings scripts/test-brand-routing.mjs",
    "test:brand-data": "node --no-warnings scripts/test-brand-data.mjs",
    "test:prune": "node --no-warnings scripts/test-prune-orphans.mjs",
    "test:unit": "vitest run",
    "test": "npm run test:unit && npm run test:brand-data && npm run test:prune && npm run test:routing"
  },
  "dependencies": {
    "@notionhq/client": "^4.0.2",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "framer-motion": "^11.18.2",
    "geist": "^1.7.2",
    "next": "^14.2.29",
    "nodemailer": "^9.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.5",
    "@vitest/coverage-v8": "^3.2.7",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.3",
    "typescript": "^5.8.2",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
